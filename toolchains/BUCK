nextest_system_tool(
    name = "nextest-real-linux-x86_64",
    visibility = ["PUBLIC"],
    executable = ":cargo-nextest-linux-x86_64-validated",
)

nextest_system_tool(
    name = "nextest-real-linux-aarch64",
    visibility = ["PUBLIC"],
    executable = ":cargo-nextest-linux-aarch64-validated",
)

nextest_system_tool(
    name = "nextest-real-macos-universal",
    visibility = ["PUBLIC"],
    executable = ":cargo-nextest-macos-universal-validated",
)

nextest_toolchain(
    name = "nextest-real",
    visibility = ["PUBLIC"],
    cargo_nextest = select({
        "ovr_config//os:linux": select({
            "ovr_config//cpu:x86_64": ":nextest-real-linux-x86_64",
            "ovr_config//cpu:arm64": ":nextest-real-linux-aarch64",
            "DEFAULT": "root//:unsupported_nextest_host",
        }),
        "ovr_config//os:macos": select({
            "ovr_config//cpu:x86_64": ":nextest-real-macos-universal",
            "ovr_config//cpu:arm64": ":nextest-real-macos-universal",
            "DEFAULT": "root//:unsupported_nextest_host",
        }),
        "DEFAULT": "root//:unsupported_nextest_host",
    }),
    bundle_platform = select({
        "ovr_config//os:linux": select({
            "ovr_config//cpu:x86_64": "x86_64-unknown-linux-musl",
            "ovr_config//cpu:arm64": "aarch64-unknown-linux-musl",
            "DEFAULT": "unsupported",
        }),
        "ovr_config//os:macos": "universal-apple-darwin",
        "DEFAULT": "unsupported",
    }),
)

# These are deterministic local fixtures for this repository's tests. A consumer
# supplies its own executable targets exposing DefaultInfo and RunInfo.
