)

nextest_toolchain(
    name = "nextest",
    visibility = ["PUBLIC"],
    cargo_nextest = ":nextest-cargo-nextest-v1",
    bundle_resources = [":fixture-runtime-resource"],
    bundle_environment = [["BUCK2_BUNDLE_RESOURCE", "relative_path", "runtime/fixture-resource.txt"], ["BUCK2_BUNDLE_LITERAL", "literal", "declared"]],
    bundle_platform = "local-fixture-v1",
)

