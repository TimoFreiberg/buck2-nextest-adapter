load(":nextest.bzl", "nextest_system_tool", "nextest_toolchain")
load("@prelude//toolchains:demo.bzl", "system_demo_toolchains")
system_demo_toolchains()

# These are deterministic local fixtures for this repository's tests. A consumer
# supplies its own executable targets exposing DefaultInfo and RunInfo.
nextest_system_tool(
    name = "nextest-cargo",
    executable = "root//:nextest-cargo-executable",
)

nextest_system_tool(
    name = "nextest-python",
    executable = "root//:nextest-python-executable",
)

nextest_system_tool(
    name = "nextest-cargo-nextest-v1",
    executable = "root//:nextest-cargo-nextest-v1-executable",
)

nextest_system_tool(
    name = "nextest-cargo-nextest-v2",
    executable = "root//:nextest-cargo-nextest-v2-executable",
)

nextest_toolchain(
    name = "nextest",
    visibility = ["PUBLIC"],
    cargo = ":nextest-cargo",
    python = ":nextest-python",
    cargo_nextest = ":nextest-cargo-nextest-v1",
)

nextest_toolchain(
    name = "nextest-v1",
    visibility = ["PUBLIC"],
    cargo = ":nextest-cargo",
    python = ":nextest-python",
    cargo_nextest = ":nextest-cargo-nextest-v1",
)

nextest_toolchain(
    name = "nextest-v2",
    visibility = ["PUBLIC"],
    cargo = ":nextest-cargo",
    python = ":nextest-python",
    cargo_nextest = ":nextest-cargo-nextest-v2",
